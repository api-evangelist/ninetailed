      "item": [
        {
          "id": "db9c69ed-17a2-43c8-854f-d2316de0de67",
          "name": "Batch Upsert Events (Synchronous)",
          "request": {
            "name": "Batch Upsert Events (Synchronous)",
            "description": {
              "content": "Synchronous batch endpoint for upserting events across multiple profiles. Supports up to 200 events total, a maximum of 50 identify events, and up to 50 unique profiles per request. Returns an array of profiles without experiences or changes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en",
                  "description": "BCP 47 locale string used for resolving localized experiences. Defaults to \"en\"."
                }
              ],
              "variable": [
                {
                  "description": "The organization ID (Client ID) found in the SDK Keys section on the Optimization tab.",
                  "type": "any",
                  "value": "{{organizationId}}",
                  "key": "organizationId"
                },
                {
                  "description": "The environment slug (e.g. \"main\").",
                  "type": "any",
                  "value": "{{environmentSlug}}",
                  "key": "environmentSlug"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
